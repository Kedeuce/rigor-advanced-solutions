# Supabase — copy this file to .env and fill in your own values.
# Supabase Dashboard > Project Settings > API
# Without these, the site still works: admin edits save to the browser's localStorage instead.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
